<launch>
    <!-- Direct standalone use keeps the historical required=true behaviour. -->
    <arg name="required" default="true"/>
    <arg name="enable_web" default="true"/>
    <arg name="web_port" default="8080"/>
    <arg name="enable_camera" default="true"/>
    <arg name="enable_target_feedback" default="true"/>
    <arg name="web_address" default="0.0.0.0"/>

    <arg
        name="model1_path"
        default="$(find r300_yolo_detector)/models/model_c6_260727.pt"
    />

    <arg
        name="model2_path"
        default="$(find r300_yolo_detector)/models/model_c7_260727.pt"
    />

    <arg
        name="config_file"
        default="$(find r300_yolo_detector)/config/dual_detector.yaml"
    />

    <node
        pkg="r300_yolo_detector"
        type="dual_yolo_depth_node_independent.py"
        name="r300_dual_yolo_depth_node"
        output="screen"
        required="$(arg required)"
    >
        <env
            name="LD_PRELOAD"
            value="/usr/lib/aarch64-linux-gnu/libgomp.so.1"
        />

        <!-- 先加载公共参数和每类别置信度阈值 -->
        <rosparam
            command="load"
            file="$(arg config_file)"
        />

        <!-- launch参数优先覆盖YAML中的模型路径 -->
        <param name="model1_path" value="$(arg model1_path)"/>
        <param name="model2_path" value="$(arg model2_path)"/>
    </node>

    <!-- 4. Web视频服务 -->
    <group if="$(arg enable_web)">
        <node
            pkg="web_video_server"
            type="web_video_server"
            name="r300_web_video_server"
            output="screen"
            respawn="true"
            respawn_delay="5.0"
        >
            <param name="port" value="$(arg web_port)"/>
            <param name="address" value="$(arg web_address)"/>
            <param name="server_threads" value="2"/>
            <param name="ros_threads" value="2"/>
        </node>
    </group>
</launch>
