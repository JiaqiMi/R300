<launch>
    <arg name="enable_web" default="true"/>
    <arg name="web_port" default="8080"/>
    <arg name="enable_camera" default="true"/>
    <arg name="enable_target_feedback" default="true"/>
    <arg name="web_address" default="0.0.0.0"/>

    <arg
        name="model1_path"
        default="$(find r300_yolo_detector)/models/c11_260711.pt"
    />

    <arg
        name="model2_path"
        default="$(find r300_yolo_detector)/models/model_c6_260723.pt"
    />
    <arg name="available_classes_topic"
         default="/r300_vision/available_classes"/>

    <!-- 1. RealSense D435i -->
    <group if="$(arg enable_camera)">
        <include file="$(find realsense2_camera)/launch/rs_camera.launch">
            <arg name="align_depth" value="true"/>
            <arg name="enable_sync" value="true"/>
        </include>
    </group>

    <!-- 2. 双YOLO检测与深度定位 -->
    <include file="$(find r300_yolo_detector)/launch/dual_yolo_depth.launch">
        <arg name="model1_path" value="$(arg model1_path)"/>
        <arg name="model2_path" value="$(arg model2_path)"/>
        <arg name="available_classes_topic"
             value="$(arg available_classes_topic)"/>
    </include>

    <!-- 3. 轻量目标坐标/经纬度实时回传（不订阅图像、不写文件） -->
    <group if="$(arg enable_target_feedback)">
        <include file="$(find r300_yolo_detector)/launch/target_feedback.launch"/>
    </group>

    <!-- 4. Web视频服务 -->
    <group if="$(arg enable_web)">
        <node
            pkg="web_video_server"
            type="web_video_server"
            name="r300_web_video_server"
            output="screen"
            respawn="true"
            respawn_delay="5.0"
        >
            <param name="port" value="$(arg web_port)"/>
            <param name="address" value="$(arg web_address)"/>
            <param name="server_threads" value="2"/>
            <param name="ros_threads" value="2"/>
        </node>
    </group>
</launch>
