<launch>
  <!-- 完全独立的泊车视觉实例：不修改、不启动原有视觉节点。 -->
  <arg name="model1_path" default="$(find r300_yolo_detector)/models/model_c6_260723.pt"/>
  <arg name="model2_path" default="$(find r300_yolo_detector)/models/parking_status_c3.pt"/>
  <arg name="config_file" default="$(find r300_autonomous_parking)/config/parking_perception.yaml"/>

  <arg name="rgb_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>

  <arg name="detections_topic" default="/r300_parking_vision/detections"/>
  <arg name="annotated_topic" default="/r300_parking_vision/annotated_image"/>
  <arg name="target_point_topic" default="/r300_parking_vision/target_point"/>

  <node
    pkg="r300_autonomous_parking"
    type="parking_perception_node.py"
    name="r300_autonomous_parking_perception"
    output="screen"
    required="true">

    <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libgomp.so.1"/>

    <rosparam command="load" file="$(arg config_file)"/>

    <param name="model1_path" value="$(arg model1_path)"/>
    <param name="model2_path" value="$(arg model2_path)"/>

    <param name="rgb_topic" value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>

    <param name="detections_topic" value="$(arg detections_topic)"/>
    <param name="annotated_topic" value="$(arg annotated_topic)"/>
    <param name="target_point_topic" value="$(arg target_point_topic)"/>
  </node>
</launch>
