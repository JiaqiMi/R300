{
  "rosbridge": {
    "host": "auto",
    "port": 9090
  },
  "video": {
    "host": "auto",
    "port": 8080,
    "topic": "/r300_vision/annotated_image",
    "quality": 30,
    "width": 640,
    "height": 480
  },
  "satellite_map": {
    "enabled": true,
    "fix_topic": "/one_x/fix",
    "tile_url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
    "attribution": "Tiles © Esri",
    "default_center": [
      38.9866,
      117.3418
    ],
    "default_zoom": 18,
    "min_distance_m": 0.2
  },
  "topics": {
    "odom": "/one_x/odom",
    "fix": "/one_x/fix",
    "gps_fix": "/one_x/gps_fix",
    "heading_deg": "/one_x/heading_deg",
    "cmd_vel": "/subject1/cmd_vel_raw",
    "global_plan": "/move_base/NavfnROS/plan",
    "local_plan": "/move_base/DWAPlannerROS/local_plan",
    "current_goal": "/move_base/current_goal",
    "costmap": "/move_base/local_costmap/costmap",
    "scan": "/scan",
    "vision_scan": "/r300_vision/obstacle_scan",
    "active_vision_scan": "/r300_vision/active_obstacle_scan",
    "lidar_scan": "/r300_lidar/obstacle_scan",
    "active_lidar_scan": "/r300_lidar/active_obstacle_scan",
    "detections": "/r300_vision/detections",
    "target_point": "/r300_vision/target_point",
    "dynamic_state": "/subject1/dynamic/state",
    "speed_limit": "/subject1/dynamic/speed_limit_mps",
    "emergency_stop": "/subject1/dynamic/emergency_stop",
    "lidar_points_json": "/r300_web/lidar_points_json",
    "elevation_json": "/r300_web/elevation_json",
    "direction_sign_state": "/subject1/direction_sign/state",
    "direction_sign_selected": "/subject1/direction_sign/selected_direction",
    "direction_sign_goal": "/subject1/direction_sign/local_goal",
    "target_feedback": "/r300_vision/target_feedback_json"
  },
  "services": {
    "start": "/subject1/start_waypoints",
    "pause": "/subject1/pause_waypoints",
    "resume": "/subject1/resume_waypoints",
    "cancel": "/subject1/cancel_waypoints",
    "skip": "/subject1/skip_waypoint",
    "reset_sign_guidance": "/subject1/direction_sign/reset"
  },
  "target_geolocation": {
    "enabled": true,
    "camera_forward_offset_m": 0.0,
    "camera_right_offset_m": 0.0,
    "max_gps_age_s": 5.0,
    "max_heading_age_s": 5.0,
    "allow_odom_yaw_fallback": true,
    "target_match_tolerance_m": 0.3
  }
}
