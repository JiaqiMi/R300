<launch>
  <!--
    共享 1X 航点导航核心 + 雷达高程图避障。

    结构与 subject1_waypoint_vision_nav.launch 一致：
      - 公共导航核心：subject1_waypoint_nav.launch
      - 雷达专用 DWA：subject1_dwa_lidar.yaml
      - 雷达专用 local costmap：subject1_local_costmap_lidar.yaml
      - 雷达适配器：subject1_lidar_avoidance.launch

    本 launch 不启动 1X，也不启动 MID-360 / FAST-LIO / 高程图。
  -->
  <arg name="can_port" default="can0"/>
  <arg name="waypoint_file"
       default="$(find r300_1x_navigation)/config/subject1_waypoints.yaml"/>

  <!-- 2026-07-29 防复发改进:
       indoor_test_mode: 室内测试模式——1X 无 GPS 时 odom 冻结(实测: 车转圈软件位姿不动),
         true 时用 lio_pose_bridge 以 FAST-LIO 位姿发布 odom->base_link 与 dwa_odom,
         室内即可闭环测试(勿给 1X 设原点! GPS 航点无效, 只用 rviz 点目标);
       require_1x_alignment: 1X 对准门检——odom 位姿逐字节冻结时拒绝进入导航并醒目报错,
         杜绝"静默假定位"(室外正常流程不受影响, 3 秒通过)。 -->
  <arg name="indoor_test_mode" default="false"/>
  <arg name="require_1x_alignment" default="true"/>
  <!-- 2026-07-30 现场开关: 地面确认限速的执行开关。false=纯观测影子模式——
       限速器照算 D 并发布 /r300_lidar/ground_speed_limit, 但不压 DWA,
       车速回落 dwa yaml 静态上限(室外1.5/室内被室内档压0.8)。
       注意: false 时接近负障碍/未验证地面【不会】减速, 只有已标记的障碍
       会被 DWA 绕行/拦停; 感知断流的兜底停车链(stop_on_stale)不受影响 -->
  <arg name="speed_limit_apply_to_dwa" default="true"/>

  <arg name="lidar_config_file"
       default="$(find r300_1x_navigation)/config/subject1_lidar_obstacles.yaml"/>
  <arg name="elevation_topic" default="/elevation_mapping/elevation_map_raw"/>
  <arg name="obstacle_scan_topic" default="/r300_lidar/obstacle_scan"/>
  <arg name="debug_cloud_topic" default="/r300_lidar/obstacle_points"/>
  <arg name="lio_map_frame" default="odom"/>
  <arg name="lio_body_frame" default="body"/>

  <!--
    摄像头道路指示牌只负责临时改变局部目标：
      暂停当前 GPS 航点 -> 发送左前/右前临时 move_base 目标
      -> 到达后恢复当前未完成的 GPS 航点。
    不改变雷达障碍层、DWA 或底盘控制链。
  -->
  <arg name="sign_guidance_enabled" default="true"/>
  <arg name="detections_topic" default="/r300_vision/detections"/>
  <arg name="sign_config_file"
       default="$(find r300_1x_navigation)/config/subject1_direction_sign.yaml"/>

  <arg name="launch_base" default="true"/>
  <arg name="launch_rviz" default="false"/>
  <arg name="auto_start" default="false"/>
  <arg name="max_goal_distance_from_origin_m" default="5000.0"/>

  <arg name="dwa_odom_topic" default="/subject1/dwa_odom"/>
  <arg name="dwa_forward_deadband_mps" default="0.02"/>
  <arg name="dwa_yaw_rate_deadband_radps" default="0.015"/>
  <arg name="dwa_forward_filter_tau_s" default="0.10"/>
  <arg name="dwa_yaw_rate_filter_tau_s" default="0.15"/>
  <arg name="dwa_max_yaw_rate_radps" default="0.75"/> <!-- 2026-07-30 0.70→0.75 与 DWA max_vel_theta 对齐: 反馈削顶低于指令上限会让顶格转向闭环失真 -->

  <include file="$(find r300_1x_navigation)/launch/subject1_waypoint_nav.launch">
    <arg name="can_port" value="$(arg can_port)"/>
    <arg name="localization_odom_topic" value="/one_x/odom"/>
    <arg name="origin_topic" value="/one_x/origin"/>
    <arg name="waypoint_file" value="$(arg waypoint_file)"/>
    <arg name="launch_base" value="$(arg launch_base)"/>
    <arg name="launch_lidar" value="false"/>
    <arg name="launch_rviz" value="$(arg launch_rviz)"/>
    <arg name="auto_start" value="$(arg auto_start)"/>
    <arg name="max_goal_distance_from_origin_m"
         value="$(arg max_goal_distance_from_origin_m)"/>

    <arg name="dwa_config_file"
         value="$(find r300_1x_navigation)/config/subject1_dwa_lidar.yaml"/>
    <arg name="local_costmap_config_file"
         value="$(find r300_1x_navigation)/config/subject1_local_costmap_lidar.yaml"/>

    <arg name="use_dwa_odom_adapter" value="$(eval not arg('indoor_test_mode'))"/>
    <arg name="dwa_odom_topic" value="$(arg dwa_odom_topic)"/>
    <arg name="dwa_forward_deadband_mps"
         value="$(arg dwa_forward_deadband_mps)"/>
    <arg name="dwa_yaw_rate_deadband_radps"
         value="$(arg dwa_yaw_rate_deadband_radps)"/>
    <arg name="dwa_forward_filter_tau_s"
         value="$(arg dwa_forward_filter_tau_s)"/>
    <arg name="dwa_yaw_rate_filter_tau_s"
         value="$(arg dwa_yaw_rate_filter_tau_s)"/>
    <arg name="dwa_max_yaw_rate_radps"
         value="$(arg dwa_max_yaw_rate_radps)"/>
  </include>

  <!-- 2026-07-29: 雷达避障模式开启全局重规划(原0=只规划一次直线, 遇障后DWA被拽着撞线;
       mevius2 同款栈一直是 1.0)。声明于此覆盖 subject1_move_base.yaml 的 0 -->
  <param name="/move_base/planner_frequency" value="1.0"/>

  <include file="$(find r300_1x_navigation)/launch/subject1_lidar_avoidance.launch">
    <arg name="config_file" value="$(arg lidar_config_file)"/>
    <arg name="elevation_topic" value="$(arg elevation_topic)"/>
    <arg name="scan_topic" value="$(arg obstacle_scan_topic)"/>
    <arg name="debug_cloud_topic" value="$(arg debug_cloud_topic)"/>
    <arg name="lio_map_frame" value="$(arg lio_map_frame)"/>
    <arg name="lio_body_frame" value="$(arg lio_body_frame)"/>
  </include>
  <!-- 声明在 include 之后覆盖 yaml 值(与室内档同机制) -->
  <param name="/lidar_obstacle_scan_node/speed_limit_apply_to_dwa"
         value="$(arg speed_limit_apply_to_dwa)"/>

  <group if="$(arg sign_guidance_enabled)">
    <node pkg="r300_1x_navigation"
          type="direction_sign_local_goal.py"
          name="direction_sign_local_goal"
          output="screen"
          required="true">
      <!-- Flat YAML keys are loaded into this node's private namespace. -->
      <rosparam command="load" file="$(arg sign_config_file)"/>
      <param name="enabled" value="true"/>
      <param name="detections_topic" value="$(arg detections_topic)"/>
      <param name="move_base_action" value="/move_base"/>
      <param name="pause_service" value="/subject1/pause_waypoints"/>
      <param name="resume_service" value="/subject1/resume_waypoints"/>
      <param name="waypoint_status_topic" value="/subject1/waypoint_status"/>
    </node>
  </group>

  <!-- 1X 对准门检(仅室外/正常模式): 位姿冻结 => exit(1) => required 拉倒整个 launch -->
  <group unless="$(arg indoor_test_mode)">
    <node if="$(arg require_1x_alignment)"
          pkg="r300_1x_navigation" type="one_x_alignment_gate.py"
          name="one_x_alignment_gate" output="screen" required="true"/>
  </group>

  <!-- 室内测试模式: FAST-LIO 位姿桥(外参复用 subject1_lidar_obstacles.yaml) -->
  <group if="$(arg indoor_test_mode)">
    <node pkg="r300_1x_navigation" type="lio_pose_bridge.py"
          name="lio_pose_bridge" output="screen" required="true">
      <rosparam command="load" file="$(arg lidar_config_file)"/>
      <param name="odom_topic" value="$(arg dwa_odom_topic)"/>
      <param name="lio_map_frame" value="$(arg lio_map_frame)"/>
      <param name="lio_body_frame" value="$(arg lio_body_frame)"/>
    </node>

    <!-- 室内档参数覆盖(2026-07-29 审查P1-5/P0-3): 持久化, 不再依赖易失的 dynparam。
         窄环境膨胀收窄+衰减加快; 车速压到0.8(全链延迟0.8~1.5s下新障碍4m必撞账,
         室内空间小必须留裕)。声明在 include 之后, roslaunch 后声明覆盖先加载的 yaml。 -->
    <param name="/move_base/local_costmap/inflation_layer/inflation_radius" value="0.40"/> <!-- 2026-07-30 0.45→0.40 缝隙通行: 0.45时0.9m缝中心软代价≈192(≈4倍中性), navfn宁绕远6m也不走缝/DWA也不愿进; 0.40时缝中心代价归0。硬下限=内切0.36(必撞环), 勿再低 -->
    <param name="/move_base/local_costmap/inflation_layer/cost_scaling_factor" value="3.0"/>
    <param name="/lidar_obstacle_scan_node/speed_limit_v_max" value="0.8"/>
    <!-- 2026-07-30 室内档补齐(全参数四代理审查):
         DWA静态上限: dynamic_reconfigure 连上并首次下发前(move_base 起动后数秒,
           失败还有 5s 退避), DWA 上限是 yaml 静态值 1.5——室内窄环境的启动窗口, 必须压死;
         margin: yaml 的 1.45 是室外含全链延迟的账, 室内 0.8m/s 下需 D≥2.17m 才提速
           =窄室内永远 0.3 爬行, 回归制动方程推导值 0.75。
         (pos_ttl 不再整体放大: "静止>20s 障碍蒸发"已由节点内近环分段记忆解决——
          pos_memory_ttl_near_s=60 只作用于 0.6~1.2m 无法再观测的环带, 其余保持 20s
          防行人残影; 整体 60s 会把室内幽灵存活期放大 3 倍, 见审查记录) -->
    <param name="/move_base/DWAPlannerROS/max_vel_x" value="0.8"/>
    <param name="/move_base/DWAPlannerROS/max_vel_trans" value="0.8"/>
    <param name="/lidar_obstacle_scan_node/speed_limit_margin" value="0.75"/>

    <!-- 2026-07-29 室内档: 全局代价地图从"2km空白图(绿线穿障直线)"改为 mevius2 架构——
         20m滚动窗+雷达快照层+膨胀, 让全局规划消费全部7.5m感知, 绿线绕障碍走,
         DWA只需跟线(根治"感知被浪费在路线层"/绕障挣扎)。室外GPS航点可能>20m,
         滚动窗会让远目标出图, 故仅室内档启用 -->
    <rosparam param="/move_base/global_costmap/plugins">
      - {name: lidar_snapshot_layer, type: "r300_1x_navigation/VisionSnapshotLayer"}
      - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    </rosparam>
    <param name="/move_base/global_costmap/static_map" value="false"/>
    <param name="/move_base/global_costmap/rolling_window" value="true"/>
    <param name="/move_base/global_costmap/width" value="20.0"/>
    <param name="/move_base/global_costmap/height" value="20.0"/>
    <param name="/move_base/global_costmap/resolution" value="0.1"/>
    <param name="/move_base/global_costmap/global_frame" value="odom"/>
    <param name="/move_base/global_costmap/update_frequency" value="2.0"/>
    <param name="/move_base/global_costmap/publish_frequency" value="1.0"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/enabled" value="true"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/topic" value="/r300_lidar/obstacle_scan"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/hold_time_s" value="3.0"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/max_message_age_s" value="1.0"/> <!-- 2026-07-30 0.5→1.0 同局部层: scan 以位姿采样时刻打戳后名义消息龄0.15~0.5s, 新鲜度把关在适配节点 -->
    <param name="/move_base/global_costmap/lidar_snapshot_layer/min_cluster_points" value="1"/> <!-- 2026-07-30 2→1 与局部层一致(P0): 细障碍(钢筋/标桩)dedup后仅剩1点, =2时整簇被丢, 全局绿线直穿细障碍→跟线-否决振荡 -->
    <param name="/move_base/global_costmap/lidar_snapshot_layer/cluster_tolerance_m" value="0.45"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/association_distance_m" value="0.50"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/publish_active_scan" value="false"/>
    <param name="/move_base/global_costmap/inflation_layer/enabled" value="true"/>
    <param name="/move_base/global_costmap/inflation_layer/inflation_radius" value="0.40"/> <!-- 2026-07-30 0.45→0.40 与局部同步(缝隙通行), 全局绿线才愿意穿可过的缝 -->
    <param name="/move_base/global_costmap/inflation_layer/cost_scaling_factor" value="3.0"/> <!-- 2026-07-30 2.0→3.0 与室内局部层统一: 两层对同一障碍贴近意愿不同会造成"跟线-离线"拉扯 -->
    <param name="/lidar_obstacle_scan_node/speed_limit_v_min" value="0.30"/>
    <!-- 2026-07-30 室内档到点容差1.5→0.3: 比赛容差1.5在rviz调试中造成"停在目标前
         1米多"被反复误读为卡死(实测三次"卡死"均为 Goal reached); 室外GPS航点不受影响 -->
    <param name="/move_base/DWAPlannerROS/xy_goal_tolerance" value="0.30"/> <!-- 2026-07-30 0.15→0.30: 实测0.15低于滑移底盘最低可动速度(指令在发/轮子不转,4秒4mm), 限速压底=瘫痪而非爬行 -->
  </group>

  <!-- 2026-07-30 室外档: 全局代价地图同样切 mevius2 架构(滚动40m+雷达快照层+膨胀),
       绿线在感知范围内绕障碍, DWA 只需跟线(与室内同构, 窗更大)。
       "GPS 航点可能>窗"由 waypoint_executor 的子目标钳制器解决(goal_clamp 18m <
       窗半宽20m, 胡萝卜滚动前移, 真航点入窗即切真目标)——对标 Nav2 GPS 教程的
       rolling global costmap + goal clamping 模式。副作用收益: 2km 空白大图不再做
       全局输入, navfn "每秒1亿格/>1GB"的审查 P1 问题随之消失(空白图服务器仅剩
       rviz 参考作用)。膨胀取室外档 1.0/2.0 与局部层一致。
       always_send_full_costmap=true: executor 的目标点障碍投影需读整幅(40m@0.1
       =160k格×1Hz, 带宽可忽略)。 -->
  <group unless="$(arg indoor_test_mode)">
    <rosparam param="/move_base/global_costmap/plugins">
      - {name: lidar_snapshot_layer, type: "r300_1x_navigation/VisionSnapshotLayer"}
      - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    </rosparam>
    <param name="/move_base/global_costmap/static_map" value="false"/>
    <param name="/move_base/global_costmap/rolling_window" value="true"/>
    <param name="/move_base/global_costmap/width" value="40.0"/>
    <param name="/move_base/global_costmap/height" value="40.0"/>
    <param name="/move_base/global_costmap/resolution" value="0.1"/>
    <param name="/move_base/global_costmap/global_frame" value="odom"/>
    <param name="/move_base/global_costmap/update_frequency" value="2.0"/>
    <param name="/move_base/global_costmap/publish_frequency" value="1.0"/>
    <param name="/move_base/global_costmap/always_send_full_costmap" value="true"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/enabled" value="true"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/topic" value="/r300_lidar/obstacle_scan"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/hold_time_s" value="3.0"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/max_message_age_s" value="1.0"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/min_cluster_points" value="1"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/cluster_tolerance_m" value="0.45"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/association_distance_m" value="0.50"/>
    <param name="/move_base/global_costmap/lidar_snapshot_layer/publish_active_scan" value="false"/>
    <param name="/move_base/global_costmap/inflation_layer/enabled" value="true"/>
    <param name="/move_base/global_costmap/inflation_layer/inflation_radius" value="1.0"/> <!-- 2026-07-30 深夜 1.3→1.0 与局部同步(操作员实测膨胀太大; 快反层已承担提前减速) -->
    <param name="/move_base/global_costmap/inflation_layer/cost_scaling_factor" value="2.0"/>
  </group>
</launch>
