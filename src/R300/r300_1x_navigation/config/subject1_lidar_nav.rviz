Panels:
  - Class: rviz/Displays
    Name: Displays
    Tree Height: 520
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Nav Goal1
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 38; 41
    Frame Rate: 15
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/SetInitialPose
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Target Frame: base_link
      Distance: 14
      Pitch: 1.0
      Yaw: 3.14
    Saved: ~
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
    - Class: rviz/TF
      Name: TF
      Enabled: false
    - Class: grid_map_rviz_plugin/GridMap
      Name: ElevationMap
      Enabled: true
      Topic: /elevation_mapping/elevation_map_raw
      Layer: elevation
      Color Layer: elevation
      Color Transformer: ColorLayer
      Use Rainbow: true
      Min Intensity: -1
      Max Intensity: 1
      Alpha: 0.55
      Height Layer: elevation
      Height Transformer: Layer
      Show Grid Lines: false
    - Class: rviz/Map
      Name: LocalCostmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
      Draw Behind: false
    - Class: rviz/Path
      Name: GlobalPlan(Navfn)
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 25; 255; 50
      Line Style: Billboards
      Line Width: 0.06
    - Class: rviz/Path
      Name: LocalPlan(DWA)
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 0; 220; 255
      Line Style: Billboards
      Line Width: 0.08
    - Class: rviz/LaserScan
      Name: LidarObstacleScan(当前帧)
      Enabled: true
      Topic: /r300_lidar/obstacle_scan
      Color: 255; 40; 40
      Color Transformer: FlatColor
      Style: Spheres
      Size (m): 0.12
    - Class: rviz/LaserScan
      Name: ActiveScan(TTL保持)
      Enabled: true
      Topic: /r300_lidar/active_obstacle_scan
      Color: 255; 220; 0
      Color Transformer: FlatColor
      Style: Spheres
      Size (m): 0.09
    - Class: rviz/PointCloud2
      Name: TerrainDebug(正负障碍)
      Enabled: true
      Topic: /r300_lidar/obstacle_points
      Color: 255; 140; 0
      Color Transformer: FlatColor
      Style: Spheres
      Size (m): 0.07
    - Class: rviz/Polygon
      Name: Footprint
      Enabled: true
      Topic: /move_base/local_costmap/footprint
      Color: 200; 0; 255
    - Class: rviz/Pose
      Name: CurrentGoal
      Enabled: true
      Topic: /move_base/current_goal
      Color: 255; 25; 240
      Shaft Length: 0.8
      Head Length: 0.3
Window Geometry:
  Width: 1500
  Height: 950
